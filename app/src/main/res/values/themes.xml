<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RegistroAsistenciaIJS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/primarioIJS</item>
        <item name="android:navigationBarColor">@color/fondoIJS</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/acentoIJS</item>
    </style>
    <style name="BotonIJS">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/primarioIJS</item>
        <item name="android:textColor">@color/textoBotonIJS</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="CampoIJS">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textoIJS</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:backgroundTint">@color/primarioIJS</item>
    </style>
</resources>
